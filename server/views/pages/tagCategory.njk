<section class="hmpps-section--dark govuk-!-padding-top-6 govuk-!-padding-bottom-6 govuk-!-margin-top-6">
	<div class="govuk-width-container">
		{% if tag.categoryFeaturedContent and tag.categoryFeaturedContent.length %}
			<h2 class="govuk-heading-l">{{ t("pages:home.featured") }}</h2>
			<div class="govuk-grid-row hmpps-category-grid">
				{% set gridItems = tag.categoryFeaturedContent %}
				{% set showContentTag = false %}
				{% set showItemSummary = true %}
				{% include '../partials/category/category-grid.njk' %}
			</div>
		{% endif %}

		{% if tag.categoryMenu and tag.categoryMenu.data.length %}
			<h2 class="govuk-heading-l">{{ t("features:category.inThisSection") }}</h2>
			<div class="govuk-grid-row hmpps-category-grid show-more-category-menu-container">
				{% set gridItems = tag.categoryMenu.data %}
				{% set showContentTag = false %}
				{% include '../partials/category/category-grid.njk' %}
			</div>


			{% if not tag.categoryMenu.isLastPage %}
				{% set buttonLocatorOverride = 'show-more-category-menu' %}
				{% set containerLocatorOverride = 'show-more-category-menu-container' %}
				{% set categoryType = 'menu' %}
				{% include '../partials/collection/collection-show-more.njk' %}

				{% set showMoreInitialised = true %}
			{% endif %}
		{% endif %}

		{% if tag.categoryContent and tag.categoryContent.length %}
			<h2 class="govuk-heading-l">{{ t("features:category.content") }}</h2>
			<div class="govuk-grid-row hmpps-category-grid show-more-category-content-container">
				{% set gridItems = tag.categoryContent %}
				{% set showSeriesTag = false %}
				{% include '../partials/category/category-grid.njk' %}
			</div>

			{% if not isLastPage %}
				{% set buttonLocatorOverride = 'show-more-category-content' %}
				{% set containerLocatorOverride = 'show-more-category-content-container' %}
				{% set categoryType = 'content' %}
				{% include '../partials/collection/collection-show-more.njk' %}
			{% endif %}
		{% endif %}

	</div>
</section>
