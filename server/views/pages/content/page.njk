{% extends "../../partials/layout.njk" %}
{% from "../../partials/breadcrumb.njk" import breadcrumb, breadcrumbNavigation %}

{% set pageTitle = data.title or applicationName %}
{% set mainClasses = "govuk-body" %}
{% set feedbackBlackBackground = false %}

{% block content %}
  {{ breadcrumbNavigation(t) }}
  {% if data.breadcrumbs and data.breadcrumbs.length %}
    {{ breadcrumb(data.breadcrumbs) }}
  {% endif %}

  <h1 class="govuk-heading-xl hmpps-page-content__title">{{ data.title }}</h1>

  <div class="hmpps-dynamic-content">
    <div class="govuk-grid-column-two-thirds hmpps-page-content__description">
      {% if data.standFirst %}
        <p class="hmpps-dynamic-content__heading">{{ data.standFirst }}</p>
      {% endif %}

      {% if data.description %}
        {{ data.description | safe }}
      {% endif %}
    </div>
  </div>


  {% if data.topics and data.topics.length %}
    <div class="hmpps-related-topics govuk-!-margin-top-6 govuk-!-padding-5">
      <h2 class="govuk-heading-m">{{ "features:relatedTopics.heading" | t }}</h2>
      <ul class="govuk-list">
        {% for topic in data.topics %}
          <li>
            <a class="govuk-link" href="/tags/{{ topic.id }}">{{ topic.name }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
{% endblock %}
